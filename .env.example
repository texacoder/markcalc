# ---- Required ----
# Your OpenAI API key (https://platform.openai.com/api-keys). Server-side only; never sent to browsers.
OPENAI_API_KEY=sk-...

# ---- Optional ----
# Vision model used for marking. gpt-4.1 is the default; gpt-5 / gpt-4.1-mini also work.
OPENAI_MODEL=gpt-4.1
# If set, teachers need this code to create an account (share it with your school only).
SIGNUP_CODE=
# Max answer sheets each teacher can mark per day (protects your OpenAI bill).
DAILY_GRADING_LIMIT=60
# Where the SQLite database is stored. On a host, point this at a persistent disk.
DATABASE_FILE=./data/markcalc.db
PORT=3000
# Set NODE_ENV=production when deployed behind HTTPS (makes login cookies secure).
NODE_ENV=development
# Set to 1 to return fake results without calling OpenAI (for demos / UI work).
MOCK_GRADER=0
