# ---- AI used for marking (set ONE of these) ----
# Free, just a GitHub account: token with the "Models" permission from
# https://github.com/settings/personal-access-tokens/new  (uses GPT-4.1; ~50 sheets/day, 7 pages each)
GITHUB_MODELS_TOKEN=
# Free, bigger limits: Google Gemini key from https://aistudio.google.com/app/apikey (needs a Google Cloud project)
GEMINI_API_KEY=
# Paid alternative: OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model overrides
# GITHUB_MODEL=openai/gpt-4.1
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4.1
# If several keys are set, force one: github | gemini | openai
# Max pages (question paper + answer sheet) per marking. Default: 7 for GitHub, 40 otherwise
# MAX_PAGES=
# AI_PROVIDER=

# ---- Database ----
# Local file (default), a free Neon/Supabase Postgres URL (postgresql://…?sslmode=require)
# or a free Turso database (libsql://<db>-<you>.turso.io)
DATABASE_URL=file:./data/markcalc.db
# Only needed for Turso
DATABASE_AUTH_TOKEN=

# ---- Limits & access ----
# If set, teachers need this code to create an account
SIGNUP_CODE=
# Max answer sheets per teacher per day
DAILY_GRADING_LIMIT=40
# Max answer sheets for the whole website per day (0 = no limit)
SITE_DAILY_LIMIT=0

# ---- Server ----
PORT=3000
# production = secure cookies (needs HTTPS). Use development for plain http.
NODE_ENV=development
# 1 = fake marks without calling any AI (for demos)
MOCK_GRADER=0
