# ---- AI used for marking (set ONE of these) ----
# Free: Groq key from https://console.groq.com/keys (sign in with GitHub/Google; Llama 4 vision, up to 5 page images)
GROQ_API_KEY=
# Free: OpenRouter key from https://openrouter.ai/keys (free models, ~50 requests/day)
OPENROUTER_API_KEY=
# Free, best quality: Google Gemini key from https://aistudio.google.com/app/apikey (needs a Google Cloud project)
GEMINI_API_KEY=
# Paid: OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any other OpenAI-compatible service: base URL (ending in /v1), key and a vision model
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# GitHub Models (did not work from Render in testing: every request got a plain "OK")
# GITHUB_MODELS_TOKEN=
# Optional model overrides
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_MODEL=meta-llama/llama-4-maverick:free
# GITHUB_MODEL=openai/gpt-4.1
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4.1
# If several keys are set, force one: gemini | groq | openrouter | custom | github | openai
# AI_PROVIDER=
# Max page images per marking. Default: 5 Groq, 10 OpenRouter, 7 GitHub, 40 Gemini/OpenAI
# MAX_PAGES=

# ---- Limits (kept in memory only; nothing is stored) ----
# Answer sheets one device (IP address) can mark per day
PER_DEVICE_DAILY_LIMIT=15
# Answer sheets the whole website can mark per day (0 = no limit)
SITE_DAILY_LIMIT=0

# ---- Server ----
PORT=3000
# 1 = fake marks without calling any AI (for demos and testing the layout)
MOCK_GRADER=0
